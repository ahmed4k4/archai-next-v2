# ============================================================
# ARCHAI SHOWCASE — Environment variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# ---------- Supabase (Project Settings -> API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Storage bucket (must match what's created in SQL)
NEXT_PUBLIC_STORAGE_BUCKET=project-media

# ---------- Public site URL (used for SEO, sitemap, OG) ----------
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# ---------- Optional: search console verification ----------
# Google Search Console meta tag value (the content attribute)
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ============================================================
# NEVER put a service_role key in NEXT_PUBLIC_* variables.
# ============================================================